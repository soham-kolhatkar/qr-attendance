# Copy to .env for local development.
DATABASE_URL=postgres://qra:qra@localhost:55432/qr_attendance
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PORT=3000
LOG_LEVEL=info
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Used only by `npm run db:seed` to create the first platform admin.
SEED_PLATFORM_ADMIN_USERNAME=owner
SEED_PLATFORM_ADMIN_PASSWORD=change-me-now

# SHA-256 fingerprint of the student app's signing certificate (printed by
# `npm run build:android` in apps/mobile). Empty accepts any signer: development only.
ANDROID_SIGNING_CERT_SHA256=

# Notifications. "log" writes emails to this server's log instead of sending them; for
# real email use "brevo" with an API key and a sender verified in Brevo.
EMAIL_PROVIDER=log
EMAIL_FROM=QR Attendance <alerts@example.com>
# BREVO_API_KEY=
# EMAIL_DAILY_LIMIT=300
# The web app's address, for links in emails (on Render it defaults to the service's address).
PUBLIC_URL=http://localhost:5173
# Firebase service account JSON (or that JSON base64-encoded), for push notifications to
# the Android app. Unset = no push notifications.
# FCM_SERVICE_ACCOUNT=
