{
  "name": "qr-attendance",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "api:dev": "npm run dev -w apps/api",
    "api:test": "npm test -w apps/api",
    "api:typecheck": "npm run typecheck -w apps/api",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:test": "npm test -w apps/web",
    "e2e": "npm run e2e -w apps/web"
  }
}
